{
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "ask",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git *": "ask",
      "git status": "allow",
      "git diff": "allow",
      "git log *": "allow",
      "rg *": "allow",
      "npm *": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "third_party_tool": {
      "*": "ask"
    },
    "external_directory": {
      "*": "ask"
    },
    "external_directory_read": {
      "*": "allow"
    }
  }
}
