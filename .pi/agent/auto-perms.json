{
  "version": 1,
  "reviewer": {
    "provider": "typesafe",
    "model": "jev-latest"
  },
  "minAllowProbability": 0.8,
  "reviewTimeoutMs": 5000,
  "historyLimit": 20,
  "maxReviewChars": 128000,
  "maxTaskContextChars": 64000,
  "permission": {
    "*": "ask",
    "path": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "read": "allow",
    "grep": "allow",
    "find": "allow",
    "ls": "allow",
    "write": "ask",
    "edit": "ask",
    "bash": {
      "*": "ask",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "pwd": "allow",
      "cd": "allow",
      "cd *": "allow",
      "command -v": "allow",
      "command -v *": "allow",
      "rg": "allow",
      "rg *": "allow",
      "grep": "allow",
      "grep *": "allow",
      "ls": "allow",
      "ls *": "allow",
      "head": "allow",
      "head *": "allow",
      "tail": "allow",
      "tail *": "allow",
      "wc": "allow",
      "wc *": "allow",
      "stat": "allow",
      "stat *": "allow",
      "du": "allow",
      "du *": "allow",
      "df": "allow",
      "df *": "allow",
      "diff": "allow",
      "diff *": "allow",
      "cmp": "allow",
      "cmp *": "allow",
      "sha256sum": "allow",
      "sha256sum *": "allow",
      "date": "allow",
      "date *": "allow",
      "which": "allow",
      "which *": "allow",
      "sort": "allow",
      "sort *": "allow",
      "echo": "allow",
      "echo *": "allow",
      "printf": "allow",
      "printf *": "allow",
      "if *": "allow",
      "for *": "allow",
      "sleep": "allow",
      "sleep *": "allow",
      "wait": "allow",
      "wait *": "allow",
      "find": "allow",
      "find *": "allow",
      "find -delete": "ask",
      "find -delete *": "ask",
      "npm": "allow",
      "npm *": "allow",
      "node": "allow",
      "node *": "allow",
      "python": "allow",
      "python *": "allow",
      "go": "allow",
      "go *": "allow",
      "npx": "allow",
      "npx *": "allow",
      "curl": "allow",
      "curl *": "allow",
      "ffmpeg": "allow",
      "ffmpeg *": "allow",
      "basecamp": "allow",
      "basecamp *": "allow",
      "herdr": "allow",
      "herdr *": "allow",
      "mkdir": "allow",
      "mkdir *": "allow",
      "cp": "allow",
      "cp *": "allow",
      "mv": "allow",
      "mv *": "allow"
    },
    "skill": {
      "*": "allow"
    },
    "web_enable": "allow",
    "web_search": "allow",
    "get_search_content": "allow",
    "fetch_content": "allow",
    "knowledge_search": "allow",
    "code_lsp": "allow",
    "code_check": "allow",
    "code_format": "allow",
    "code_ast": "allow",
    "web_screenshot": "allow",
    "image_generate": "allow",
    "video_generate": "allow",
    "external_directory": {
      "*": "ask",
      "/tmp/*": "allow"
    },
    "external_directory_read": {
      "*": "allow"
    }
  },
  "rules": [
    {
      "id": "project-development",
      "effect": "allow",
      "when": "The action is local development (write, edit, bash, etc.) needed for the user's task."
    }
  ]
}
