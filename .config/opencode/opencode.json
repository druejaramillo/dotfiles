{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": [
    [
      "@plannotator/opencode@latest",
      {
        "workflow": "user-managed",
        "planningAgents": ["phase-planner"]
      }
    ]
  ],
  "formatter": {},
  "lsp": {},
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "max"
          }
        },
        "gpt-5.6-terra": {
          "options": {
            "reasoningEffort": "xhigh"
          }
        },
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    },
    "xai": {
      "models": {
        "grok-4.5": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.4-nano",
  "default_agent": "phase-planner",
  "permission": {
    "read": {
      "*": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.example": "allow"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "question": "allow",
    "todowrite": "allow",
    "skill": "allow",
    "submit_plan": "deny",
    "edit": "ask",
    "task": "ask",
    "external_directory": {
      "*": "deny",
      "~/.config/opencode/**": "allow"
    },
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git rev-parse*": "allow",
      "git branch --show-current*": "allow"
    }
  }
}
