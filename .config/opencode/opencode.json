{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "plugin": ["@plannotator/opencode@latest"],
  "formatter": {},
  "lsp": {},
  "provider": {
    "openai": {
      "models": {
        "gpt-5.6-sol": {
          "options": {
            "reasoningEffort": "max"
          }
        },
        "gpt-5.6-terra": {
          "options": {
            "reasoningEffort": "xhigh"
          }
        },
        "gpt-5.6-luna": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    },
    "xai": {
      "models": {
        "grok-4.5": {
          "options": {
            "reasoningEffort": "high"
          }
        }
      }
    }
  },
  "model": "openai/gpt-5.6-terra",
  "small_model": "openai/gpt-5.4-nano"
}
