{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n—\nmm",
          "birthYear": 2002,
          "lifeExpectancy": 90
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.thisisgm.omapods"
        },
        {
          "id": "quickshell.spotify",
          "deviceName": "Omarchy Spotify",
          "idleShutdownMinutes": 15,
          "showMiniPlayer": "On",
          "shortcutPlayer": "Mini player",
          "shortcutHints": "On",
          "showTrackTitle": "Off",
          "showArtistName": "Off",
          "showPausedTrack": "Off",
          "scrollBarText": "Off",
          "scrollSpeed": "1",
          "maxBarTextWidth": "240",
          "audioQuality": "320 kbps"
        },
        {
          "id": "hass"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "jankeesvw.time-machine"
        },
        {
          "id": "omarchy.dropbox"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ]
    },
    "position": "top",
    "transparent": false
  },
  "idle": {
    "lock": 600,
    "screensaver": 300
  },
  "plugins": [
    {
      "id": "drue.lock"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "drue.lock"
  ]
}
